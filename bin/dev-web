#!/bin/sh
# Serves the web view on the port Drupal's hub and OAuth client expect.
# post_max_size stays above the upload limit, so PHP reports a large file instead of dropping the form.
cd "$(dirname "$0")/.."
# One worker would stall every player during a slow model call.
export PHP_CLI_SERVER_WORKERS=8
exec php -d upload_max_filesize=25M -d post_max_size=200M -S 127.0.0.1:8000 -t public public/index.php
