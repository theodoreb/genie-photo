+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\mcp_server\Subscription;
+
+use Drupal\Core\KeyValueStore\KeyValueExpirableFactoryInterface;
+use Drupal\Core\KeyValueStore\KeyValueStoreExpirableInterface;
+use Psr\SimpleCache\CacheInterface;
+
+/**
+ * A PSR-16 cache on Drupal's expirable key-value store.
+ *
+ * The SDK's Psr16NotificationBus keeps its notifications here. Each PHP worker
+ * reads the same database rows, so a request that changes something reaches
+ * the subscriptions/listen streams held by other workers.
+ */
+final class KeyValueSimpleCache implements CacheInterface {
+
+  /**
+   * The store holding the entries.
+   */
+  private readonly KeyValueStoreExpirableInterface $store;
+
+  /**
+   * Constructs a KeyValueSimpleCache.
+   *
+   * @param \Drupal\Core\KeyValueStore\KeyValueExpirableFactoryInterface $factory
+   *   The expirable key-value factory.
+   * @param string $collection
+   *   The collection that holds the entries.
+   */
+  public function __construct(KeyValueExpirableFactoryInterface $factory, string $collection) {
+    $this->store = $factory->get($collection);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function get(string $key, mixed $default = NULL): mixed {
+    return $this->store->get($key, $default);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function set(string $key, mixed $value, null|int|\DateInterval $ttl = NULL): bool {
+    $seconds = self::seconds($ttl);
+    if ($seconds === NULL) {
+      $this->store->set($key, $value);
+    }
+    elseif ($seconds > 0) {
+      $this->store->setWithExpire($key, $value, $seconds);
+    }
+    else {
+      $this->store->delete($key);
+    }
+    return TRUE;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function delete(string $key): bool {
+    $this->store->delete($key);
+    return TRUE;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function clear(): bool {
+    $this->store->deleteAll();
+    return TRUE;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getMultiple(iterable $keys, mixed $default = NULL): iterable {
+    $keys = [...$keys];
+    return $this->store->getMultiple($keys) + array_fill_keys($keys, $default);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setMultiple(iterable $values, null|int|\DateInterval $ttl = NULL): bool {
+    foreach ($values as $key => $value) {
+      $this->set((string) $key, $value, $ttl);
+    }
+    return TRUE;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function deleteMultiple(iterable $keys): bool {
+    $this->store->deleteMultiple([...$keys]);
+    return TRUE;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function has(string $key): bool {
+    return $this->store->has($key);
+  }
+
+  /**
+   * Turns a PSR-16 time to live into seconds, NULL for no expiry.
+   */
+  private static function seconds(null|int|\DateInterval $ttl): ?int {
+    if ($ttl instanceof \DateInterval) {
+      return (new \DateTimeImmutable('@0'))->add($ttl)->getTimestamp();
+    }
+    return $ttl;
+  }
+
+}
