From 51990955f353815cbe4cc98685d1b43eae76bef7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Th=C3=A9odore=20BIADALA?= <theodore@biadala.net>
Date: Thu, 19 Nov 2026 08:43:37 +0100
Subject: [PATCH 1/3] Serve and install any PHP project

drupack php-server reaches FrankenPHP's server, and drupack composer runs outside a Drupal project.
---
 launcher/composer.go      | 13 ++-----------
 launcher/composer_test.go | 17 -----------------
 launcher/parse.go         |  2 +-
 launcher/start_test.go    |  2 --
 4 files changed, 3 insertions(+), 31 deletions(-)

diff --git a/launcher/composer.go b/launcher/composer.go
index 379a3db..9865ce2 100644
--- a/launcher/composer.go
+++ b/launcher/composer.go
@@ -6,7 +6,6 @@ import (
 	"strings"
 
 	"git.tresbien.tech/tresbientech/drupack/launcher/internal/cache"
-	"git.tresbien.tech/tresbientech/drupack/launcher/internal/siteconfig"
 )
 
 // refusedComposerCommands are the Composer commands the engine refuses, with the
@@ -20,19 +19,11 @@ var refusedComposerCommands = []struct {
 }
 
 // engineComposer plans the engine's composer command: the engine's phar on the
-// runtime's php-cli, in the Drupal project at cwd. A create-project runs from any
-// directory.
+// runtime's php-cli, in the project at cwd, Drupal or not.
 func engineComposer(f Facts, c command, cwd string) (Command, error) {
-	command, err := composerRefusal(f.Launch, c.words)
-	if err != nil {
+	if _, err := composerRefusal(f.Launch, c.words); err != nil {
 		return Command{}, err
 	}
-	// Composer runs create-project from any prefix of two letters or more; "c" is ambiguous.
-	if len(command) < 2 || !strings.HasPrefix("create-project", command) {
-		if err := siteconfig.CheckDrupal(cwd); err != nil {
-			return Command{}, err
-		}
-	}
 	return runtimePHPCall(f, Reader, f.Application, append([]string{filepath.Join(f.Application, cache.ComposerPhar)}, c.words...)), nil
 }
 
