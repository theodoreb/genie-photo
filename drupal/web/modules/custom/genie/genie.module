<?php

/**
 * @file
 * Hooks of the genie module.
 */

use Drupal\consumers\Entity\ConsumerInterface;

/**
 * Implements hook_ENTITY_TYPE_presave() for consumer entities.
 *
 * A dynamically registered client gets genie as its default scope, whatever it
 * asked for at registration.
 */
function genie_consumer_presave(ConsumerInterface $consumer): void {
  if ($consumer->isNew() && !$consumer->get('is_default')->value) {
    $consumer->set('authorization_code_scopes', [['scope_id' => 'genie']]);
  }
}
