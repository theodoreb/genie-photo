#!/usr/bin/env php
<?php

// Critical path of a sticker: a player's assistant draws one and the shared frame changes.

declare(strict_types=1);

use App\Tests\Smoke\SmokeSite;

require dirname(__DIR__).'/vendor/autoload.php';

$site = new SmokeSite();
$token = $site->signIn($argv[1] ?? 'alice');
$site->uploadPhoto($token);
$before = $site->photos->frame($token, $site->markPlace($token));

$outcome = $site->tools->call($token, 'set_sticker', [
    'rows' => array_fill(0, 32, str_repeat('0', 16).str_repeat('*', 8).str_repeat('.', 8)),
    'palette' => ['#ff00aa'],
    'blur' => 2,
]);
echo $outcome['reply'], "\n";

$after = $site->photos->frame($token, $outcome['revision']);
if (hash('sha256', $before) === hash('sha256', $after)) {
    SmokeSite::fail('The frame did not change.');
}
echo "revision {$outcome['revision']}\n";
