#!/bin/sh
# Puts this project's Drupack build in drupal/drupack. It runs Drupal, the web view and Composer,
# so the machine needs no PHP. fork/drupack holds its changes to Drupack.
set -eu
cd "$(dirname "$0")/../drupal"

tag=drupack-1.0.0-rc6-genie.2
file=$tag-linux-amd64-glibc
sha256=0b9ac0c957b7ae36d71265ab20309d9a3d846979867736e6c5dadea17f0396c4
url=https://github.com/theodoreb/genie-photo/releases/download/$tag/$file

matches() {
    echo "$sha256  $1" | sha256sum --check --status
}

refuse() {
    echo 'The Drupack build runs on Linux x86-64 with glibc 2.28 or later. Run docker compose up instead.' >&2
    exit 1
}

[ "$(uname -sm)" = 'Linux x86_64' ] || refuse
# getconf prints nothing usable on musl.
glibc="$(getconf GNU_LIBC_VERSION 2>/dev/null | cut -d' ' -f2)"
[ -n "$glibc" ] || refuse
printf '2.28\n%s\n' "$glibc" | sort -V -c 2>/dev/null || refuse

if [ -f drupack ] && matches drupack; then
    exit 0
fi

download="$(mktemp ./.drupack.XXXXXX)"
trap 'rm -f "$download"' EXIT
curl -fsSL --retry 2 -o "$download" "$url"
# The file comes from the network and is about to run, so a wrong checksum stops the start.
if ! matches "$download"; then
    echo "$file does not match its checksum. It was not installed." >&2
    exit 1
fi
chmod 755 "$download"
mv -f "$download" drupack
echo "Installed $file."
