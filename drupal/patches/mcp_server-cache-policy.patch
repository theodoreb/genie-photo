   /**
+   * Builds the caching hints policy from the "cache" setting (SEP-2549).
+   *
+   * The SDK stamps these hints on cacheable results of the 2026-07-28
+   * revision. A result that carries its own hints keeps them.
+   *
+   * @param \Drupal\Core\Config\ImmutableConfig $config
+   *   The mcp_server.settings configuration.
+   *
+   * @return \Mcp\Server\Wire\CachePolicy
+   *   The default TTL and scope, with each per-method override applied.
+   */
+  private function buildCachePolicy(ImmutableConfig $config): CachePolicy {
+    $cache = $config->get('cache');
+    $policy = CachePolicy::default($cache['ttl_ms'], CacheScope::from($cache['scope']));
+    foreach ($cache['methods'] as $method => $override) {
+      $policy = $policy->withMethod($method, $override['ttl_ms'], CacheScope::from($override['scope']));
+    }
+    return $policy;
+  }
