#!/usr/bin/env php
<?php

// Critical path of approval: all four players approve the same picture, a new wish
// voids the approvals, and an assistant reaches neither the photo nor the web view's approval tool.

declare(strict_types=1);

use App\Drupal\DrupalToolFailed;
use App\Tests\Smoke\SmokeSite;
use Symfony\Component\HttpKernel\Exception\HttpException;

require dirname(__DIR__).'/vendor/autoload.php';

$site = new SmokeSite();
$tokens = [];
foreach (['alice', 'bob', 'carol', 'dan'] as $index => $player) {
    $tokens[$player] = $site->signIn($player);
    if (0 === $index) {
        $site->uploadPhoto($tokens[$player]);
    }
    $site->markPlace($tokens[$player], 100 + 350 * $index);
}

$approveAll = static function () use ($site, $tokens): array {
    $hash = $site->tools->call($tokens['alice'], 'session_get')['export']['hash'];
    foreach ($tokens as $token) {
        $state = $site->tools->call($token, 'export_approve', ['hash' => $hash]);
    }

    return $state;
};

$assistant = $site->signInAsAssistant('alice');
try {
    $site->photos->get($assistant);
    SmokeSite::fail('An assistant read the photo.');
} catch (HttpException $e) {
    if (403 !== $e->getStatusCode()) {
        throw $e;
    }
}
try {
    $site->tools->call($assistant, 'export_approve', ['hash' => 'x']);
    SmokeSite::fail("An assistant reached the web view's approval tool.");
} catch (DrupalToolFailed) {
}

if (!$approveAll()['final']) {
    SmokeSite::fail('Four approvals did not make the picture final.');
}
$site->tools->call($tokens['bob'], 'make_wish', ['wish' => 'hide my face']);
if ($site->tools->call($tokens['alice'], 'session_get')['export']['final']) {
    SmokeSite::fail('A new wish did not void the approvals.');
}

$state = $approveAll();
if (!$state['final']) {
    SmokeSite::fail('The new picture did not become final.');
}
echo $state['hash'], "\n";
