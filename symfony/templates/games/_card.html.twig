<li>
    <a class="card" href="{{ path('app_game', {game: game.id}) }}">
        {# A finished game shows its last picture. An open one shows its photo, which never changes. #}
        <img loading="lazy" alt="{{ game.credit ? game.credit.title : 'A group photo' }}"
             src="{{ path('app_game_picture', {game: game.id, view: game.state != 'open' and game.has_picture ? 'frame' : 'photo'}) }}">
        {% if game.state == 'open' %}
            <span>{{ game.players|length }} playing, {{ game.free }} to claim</span>
        {% else %}
            <span>{{ game.state == 'closed' ? 'Approved by everyone' : 'Left as it was' }}</span>
        {% endif %}
    </a>
</li>
