--- /dev/null
+++ b/mcp_server.post_update.php
@@ -0,0 +1,23 @@
+<?php
+
+/**
+ * @file
+ * Post update functions for the MCP Server module.
+ */
+
+declare(strict_types=1);
+
+use Drupal\Core\Config\FileStorage;
+
+/**
+ * Adds the caching hints setting, which caches nothing until configured.
+ */
+function mcp_server_post_update_cache_policy(): void {
+  $settings = \Drupal::configFactory()->getEditable('mcp_server.settings');
+  if ($settings->get('cache') !== NULL) {
+    return;
+  }
+  $path = \Drupal::service('extension.list.module')->getPath('mcp_server');
+  $defaults = (new FileStorage($path . '/config/install'))->read('mcp_server.settings');
+  $settings->set('cache', $defaults['cache'])->save();
+}
