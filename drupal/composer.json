{
    "name": "genie-photo/drupal",
    "description": "Drupal backend of the genie photo: accounts and all session data, reached over MCP.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "drupal/ai",
                "version": "dev-2.x",
                "type": "drupal-module",
                "license": "GPL-2.0-or-later",
                "source": {
                    "type": "git",
                    "url": "https://git.drupalcode.org/project/ai.git",
                    "reference": "5d6ae6f5ae6c5f9beff9cbe179875109993f331e"
                },
                "extra": {
                    "branch-alias": {
                        "dev-2.x": "2.x-dev"
                    }
                },
                "require": {
                    "drupal/core": "^11.2",
                    "drupal/key": "^1.18",
                    "drupal/symfony_http_client": "^1.0",
                    "drupal/token": "^1.16",
                    "league/commonmark": "^2.8",
                    "league/html-to-markdown": "^5.2.3",
                    "yethee/tiktoken": "^1.1.1",
                    "openai-php/client": ">=v0.10.1",
                    "symfony/ai-platform": "^1.0",
                    "symfony/ai-generic-platform": "^1.0"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "2.0.0",
        "drupal/ai": "2.x-dev@dev",
        "drupal/compound_field": "1.0.0-alpha4",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/json_field": "^1.7",
        "drupal/mcp_server": "^2.0@beta",
        "drupal/mcp_server_oauth": "^1.0@alpha",
        "drupal/simple_oauth": "^6.1",
        "drupal/state_machine": "^1.15",
        "drush/drush": "^13.6",
        "e0ipso/simple_oauth_21": "^1.13",
        "mcp/sdk": "dev-main as 0.9.99",
        "symfony/ai-cache-platform": "dev-main",
        "symfony/ai-failover-platform": "dev-main",
        "symfony/ai-generic-platform": "dev-main as 1.0.0",
        "symfony/ai-open-ai-platform": "dev-main",
        "symfony/ai-open-responses-platform": "dev-main as 1.0.0",
        "symfony/ai-platform": "dev-main as 1.0.0"
    },
    "require-dev": {
        "codewithkyrian/transformers": "^0.6.2",
        "drupal/core-dev": "^11.4",
        "symfony/ai-transformers-php-platform": "dev-main"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true,
            "symfony/runtime": true,
            "cweagans/composer-patches": true,
            "codewithkyrian/platform-package-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupack": {
            "mercure": true
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/example.gitignore": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "patches": {
            "e0ipso/simple_oauth_21": {
                "Allow http://localhost redirect URIs for native clients": "patches/simple_oauth_21-localhost-redirect.patch"
            },
            "drupal/mcp_server": {
                "Run on mcp/sdk 0.10 and later": "patches/mcp_server-mcp-sdk-0.10.patch",
                "Deliver notifications on subscriptions/listen": "patches/mcp_server-notification-bus.patch",
                "Stamp caching hints from a cache setting": "patches/mcp_server-cache-policy.patch"
            },
            "symfony/ai-failover-platform": {
                "Fail over when a deferred request fails": "patches/symfony-ai-failover-platform-deferred.patch"
            },
            "symfony/ai-cache-platform": {
                "Cache structured output objects that hold enums or objects": "patches/symfony-ai-cache-platform-nested-objects.patch"
            }
        },
        "composer-patches": {
            "disable-resolvers": [
                "\\cweagans\\Composer\\Resolver\\Dependencies"
            ]
        }
    }
}
