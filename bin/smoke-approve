#!/usr/bin/env php
<?php

// Critical path of approval: all four players approve the same picture, a new wish
// voids the approvals, an assistant does not reach the web view's tools, and a request
// for approval leads to the page, which alone records it.

declare(strict_types=1);

use App\Drupal\DrupalToolFailed;
use App\Tests\Smoke\SmokeSite;
use Mcp\Client\Client;
use Mcp\Client\Handler\Request\ElicitationCallbackInterface;
use Mcp\Client\Handler\Request\ElicitationRequestHandler;
use Mcp\Client\Transport\HttpTransport;
use Mcp\Schema\ClientCapabilities;
use Mcp\Schema\Enum\ElicitAction;
use Mcp\Schema\Enum\ProtocolVersion;
use Mcp\Schema\Request\ElicitRequest;
use Mcp\Schema\Result\ElicitResult;

require dirname(__DIR__).'/vendor/autoload.php';

$site = new SmokeSite('alice', 'bob', 'carol', 'dan', 'erin');
$tokens = [];
foreach (['alice', 'bob', 'carol', 'dan'] as $index => $player) {
    $tokens[$player] = $site->signIn($player);
    if (0 === $index) {
        $site->uploadPhoto($tokens[$player]);
    }
    $site->markPlace($tokens[$player], 100 + 350 * $index);
}

$approve = static function (string ...$players) use ($site, &$tokens): array {
    $hash = $site->tools->call($tokens['alice'], 'session_get')['export']['hash'];
    foreach ($players as $player) {
        $state = $site->tools->call($tokens[$player], 'export_approve', ['hash' => $hash]);
    }

    return $state;
};

$assistant = $site->signInAsAssistant('alice');
foreach (['picture_get', 'export_approve', 'protect_set', 'proposal_dismiss'] as $tool) {
    try {
        $site->tools->call($assistant, $tool, ['hash' => 'x']);
        SmokeSite::fail("An assistant reached $tool.");
    } catch (DrupalToolFailed) {
    }
}

if (['dan', 'erin'] !== $approve('alice', 'bob', 'carol')['waiting_for']) {
    SmokeSite::fail('Three approvals did not leave dan and erin to approve.');
}
$site->tools->call($tokens['bob'], 'make_wish', ['wish' => 'hide my face']);
if ($site->tools->call($tokens['alice'], 'session_get')['export']['approved_by_you']) {
    SmokeSite::fail('A new wish did not void the approvals.');
}

// A client that cannot open pages gets the link.
$site->tools->call($tokens['bob'], 'make_wish', ['wish' => 'show me']);
$asked = $site->tools->call($assistant, 'approve_export');
if ('waiting_on_web' !== $asked['status'] || $asked['approved_by_you'] || !str_contains((string) $asked['review_url'], '/review/')) {
    SmokeSite::fail('A plain client did not get the approval link.');
}
$page = static fn (string $url): string => parse_url($url, \PHP_URL_PATH).'?'.parse_url($url, \PHP_URL_QUERY);
$approveOnPage = static function (string $player, string $url) use ($site, $page): void {
    $browser = $site->openWebPage($player, $page($url));
    $browser->submit($browser->getCrawler()->filter('#approve')->form());
};
$approveOnPage('alice', $asked['review_url']);
if ('approved' !== $site->tools->call($assistant, 'approve_export')['status']) {
    SmokeSite::fail('The approval on the page did not reach the assistant.');
}

// A client that opens pages waits for the click, and its "accept" records nothing.
$askWithUrlClient = static function (string $player, callable $onPage, ProtocolVersion $version = ProtocolVersion::V2025_11_25) use ($site): array {
    $handler = new class($onPage) implements ElicitationCallbackInterface {
        public function __construct(private readonly mixed $onPage)
        {
        }

        public function __invoke(ElicitRequest $request): ElicitResult
        {
            ($this->onPage)((string) $request->url);

            return new ElicitResult(ElicitAction::Accept);
        }
    };
    $client = Client::builder()
        ->setProtocolVersion($version)
        ->setCapabilities(new ClientCapabilities(elicitation: true, elicitationUrl: true))
        ->addRequestHandler(new ElicitationRequestHandler($handler))
        ->setRequestTimeout(60)
        ->build();
    $client->connect(new HttpTransport($site->drupalUrl.'/mcp', headers: ['Authorization' => 'Bearer '.$site->signInAsAssistant($player)]));
    $result = $client->callTool('approve_export');
    $client->disconnect();

    return (array) $result->structuredContent;
};
$opened = $askWithUrlClient('bob', static fn (string $url) => $approveOnPage('bob', $url));
if ('approved' !== $opened['status'] || !$opened['approved_by_you']) {
    SmokeSite::fail('The opened page did not finish the request.');
}
$modern = $askWithUrlClient('dan', static fn (string $url) => $approveOnPage('dan', $url), ProtocolVersion::V2026_07_28);
if ('approved' !== $modern['status']) {
    SmokeSite::fail('A client on the newest revision did not reach the page.');
}
$accepted = $askWithUrlClient('carol', static fn () => $site->tools->call($tokens['dan'], 'make_wish', ['wish' => 'hide my face']));
if ('picture_changed' !== $accepted['status'] || $accepted['approved_by_you']) {
    SmokeSite::fail('An accepted prompt alone counted as an approval.');
}

$client = Client::builder()->build();
$client->connect(new HttpTransport($site->drupalUrl.'/mcp', headers: ['Authorization' => 'Bearer '.$tokens['alice']]));
$schemas = array_column($client->listTools()->tools, 'outputSchema', 'name');
$client->disconnect();
if (!isset($schemas['approve_export'], $schemas['export_approve'])) {
    SmokeSite::fail('An approval tool declares no output schema.');
}
// erin joined without a place, so four approvals leave the game open.
if (['erin'] !== $approve('alice', 'bob', 'carol', 'dan')['waiting_for']) {
    SmokeSite::fail('A seated guest without a place did not hold the game open.');
}
$tokens['erin'] = $site->signIn('erin');
$site->markPlace($tokens['erin'], 1500);

// The last approval closes the game for good.
$state = $approve('alice', 'bob', 'carol', 'dan', 'erin');
if (!$state['final'] || 'closed' !== $site->tools->call($tokens['alice'], 'session_get')['state']) {
    SmokeSite::fail('Four approvals did not close the game.');
}
try {
    $site->tools->call($tokens['bob'], 'make_wish', ['wish' => 'show me']);
    SmokeSite::fail('A closed game took a wish.');
} catch (DrupalToolFailed) {
}
echo $state['hash'], "\n";
