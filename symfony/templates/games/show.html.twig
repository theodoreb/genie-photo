{% extends 'base.html.twig' %}

{% set title = game.credit ? game.credit.title : 'A group photo' %}

{% block title %}{{ title }} - Genie{% endblock %}

{% block importmap %}{{ importmap('games') }}{% endblock %}

{% block body %}
{{ include('games/_header.html.twig') }}

<main id="main" class="wrap">
    <p class="crumb"><a href="{{ path('app_games') }}">All games</a></p>

    <div class="game-layout">
        <figure class="picture-frame">
            <img class="frame" alt="{{ game.has_picture ? 'The picture as every wish leaves it' : 'The picture the game started from' }}"
                 src="{{ path('app_game_picture', {game: game.id, view: game.has_picture ? 'frame' : 'photo'}) }}?r={{ game.revision }}">
        </figure>

        <div class="side">
            <h1>{{ title }}</h1>

            {% if game.withheld %}
                <p><span class="badge withheld">Withheld</span> {{ game.withheld }}</p>
            {% elseif game.state == 'closed' %}
                <p><span class="badge closed">Final</span> Everyone approved. This picture is final.</p>
            {% elseif game.state == 'abandoned' %}
                <p><span class="badge abandoned">Left as it was</span> This game saw no change for a day.</p>
            {% else %}
                <p><span class="badge open">Open</span> {{ game.free }} {{ game.free == 1 ? 'person is' : 'people are' }} left to claim.</p>
            {% endif %}

            <p>{% if game.players %}Playing: {{ game.players|join(', ') }}.{% else %}Nobody plays yet.{% endif %}</p>

            {% if game.join %}
                {# Drupal seats the player, signs them in, and sends them to their game. #}
                <section class="panel" aria-labelledby="join-title">
                    <h2 id="join-title">Take a place</h2>
                    <form class="join" method="post" action="{{ game.join }}">
                        <label for="name">Your name in the game</label>
                        <input id="name" name="name" maxlength="30" required autocomplete="nickname">
                        <button>Take a place in this picture</button>
                    </form>
                    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
                    <p class="quiet">An AI agent can join for you: <a href="{{ path('app_agent_guide') }}">{{ url('app_agent_guide') }}</a> has the steps.</p>
                </section>
            {% elseif game.state == 'open' and not game.credit %}
                <p class="quiet">The host invites the players of this game.</p>
            {% endif %}

            {% if game.credit %}
                <p class="quiet">
                    <a href="{{ game.credit.page }}">{{ game.credit.title }}</a>{% if game.credit.author %}, {{ game.credit.author }}{% endif %}{% if game.credit.date is defined %}, {{ game.credit.date }}{% endif %}.
                    {{ game.credit.licence }}, from {{ game.credit.source }}.
                </p>
            {% endif %}
        </div>
    </div>
</main>

{{ include('games/_footer.html.twig') }}
{% endblock %}
