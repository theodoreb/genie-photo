+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\mcp_server\Capability\Handler;
+
+use Mcp\Server\Capability\Registry\ElementReference;
+use Mcp\Server\Capability\Registry\ReferenceHandlerInterface;
+use Mcp\Server\Capability\Registry\ToolReference;
+
+/**
+ * Hands tool plugins their arguments as nested arrays.
+ *
+ * Since mcp/sdk 0.10, a JSON object nested in tools/call arguments reaches
+ * ToolHandlerInterface::execute() as \stdClass. Tool plugins read nested
+ * values as arrays, so this turns each nested \stdClass back into an array.
+ * The SDK's own objects in the arguments, such as _session, stay as they are.
+ */
+final readonly class ArrayArgumentsReferenceHandler implements ReferenceHandlerInterface {
+
+  /**
+   * Constructs an ArrayArgumentsReferenceHandler.
+   *
+   * @param \Mcp\Server\Capability\Registry\ReferenceHandlerInterface $inner
+   *   The reference handler doing the actual dispatch.
+   */
+  public function __construct(
+    private ReferenceHandlerInterface $inner,
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function handle(ElementReference $reference, array $arguments): mixed {
+    if ($reference instanceof ToolReference) {
+      $arguments = array_map(self::toArrays(...), $arguments);
+    }
+    return $this->inner->handle($reference, $arguments);
+  }
+
+  /**
+   * Turns \stdClass values into arrays, at every depth.
+   */
+  private static function toArrays(mixed $value): mixed {
+    if ($value instanceof \stdClass) {
+      $value = get_object_vars($value);
+    }
+    return is_array($value) ? array_map(self::toArrays(...), $value) : $value;
+  }
+
+}
