#!/usr/bin/env php
<?php

// Critical path of the live view: alice uploads the photo and listens on the hub,
// bob marks his place, and alice hears the new revision.

declare(strict_types=1);

use App\Tests\Smoke\SmokeSite;

require dirname(__DIR__).'/vendor/autoload.php';

$site = new SmokeSite();
$alice = $site->signIn('alice');
$bob = $site->signIn('bob');
$site->uploadPhoto($alice);

$photo = $site->tools->call($alice, 'session_get')['photo'];
if (1600 !== $photo['width'] || 800 !== $photo['height']) {
    exit("Photo was not scaled: {$photo['width']}x{$photo['height']}\n");
}

$stream = $site->http->request('GET', $site->drupalUrl.'/.well-known/mercure', [
    'query' => ['match' => 'genie/session'],
    'headers' => ['Accept' => 'text/event-stream'],
    'timeout' => 15,
]);
$stream->getHeaders();

$revision = $site->markPlace($bob);

foreach ($site->http->stream($stream, 10) as $chunk) {
    if ($chunk->isTimeout() || $chunk->isLast()) {
        exit("No update reached the subscriber.\n");
    }
    if (str_contains($chunk->getContent(), '"revision":'.$revision)) {
        echo "alice received revision {$revision}\n";
        exit(0);
    }
}
