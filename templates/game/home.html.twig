{% extends 'base.html.twig' %}

{% block body %}
<header class="bar">
    <strong>Genie</strong>
    <span class="grow" id="status" role="status"></span>
    <span>{{ app.user.name }}</span>
    <form method="post" action="{{ path('app_logout') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button>Sign out</button>
    </form>
</header>

{% for message in app.flashes('error') %}
    <p class="error">{{ message }}</p>
{% endfor %}

<main id="game"
      data-hub-url="{{ hub_url }}"
      data-session-url="{{ path('app_session') }}"
      data-frame-url="{{ path('app_frame', {revision: 0})|replace({'/0': '/'}) }}"
      data-region-url="{{ path('app_region') }}"
      data-protect-url="{{ path('app_protect') }}"
      data-approve-url="{{ path('app_approve') }}"
      data-propose-url="{{ path('app_proposals') }}"
      data-dismiss-url="{{ path('app_proposal_dismiss') }}"
      data-region-token="{{ csrf_token('regions') }}"
      data-session="{{ session|json_encode }}"
      data-player="{{ app.user.uid }}">
    {% if session.photo %}
        <div class="panels">
            <section>
                <h2>The shared photo</h2>
                <img id="frame" class="frame" alt="The photo as every wish leaves it">
                <p id="blocked" class="hint" hidden></p>
                <p class="hint">Ask your assistant to make a wish, such as "hide my face".</p>
                <div class="bar approval">
                    <button id="approve" type="button" hidden>I approve this picture</button>
                    <a id="download" download="genie-photo.png" hidden>Download the final photo</a>
                    <span id="approval"></span>
                </div>
            </section>
            <section>
                <h2>Mark your place</h2>
                <div id="stage" class="stage">
                    <img id="photo" src="{{ path('app_photo') }}" alt="The original group photo" draggable="false">
                    <div id="regions"></div>
                    <div id="draft" class="region draft" hidden></div>
                </div>
                <form id="mark" class="bar" hidden>
                    {% if session.is_uploader %}
                        <input name="label" maxlength="40" placeholder="Object name" aria-label="Object name">
                        <button name="kind" value="object">Mark object</button>
                    {% endif %}
                    <button name="kind" value="person">This is me</button>
                </form>
                <p class="hint">Drag on the photo, or click a proposed box.</p>
                {% if session.is_uploader %}
                    <p><button id="propose" type="button">Find people with the local model</button></p>
                {% endif %}
                <ul id="proposals" class="objects"></ul>
                <ul id="objects" class="objects"></ul>
            </section>
        </div>
    {% else %}
        <form class="upload" method="post" action="{{ path('app_photo_upload') }}" enctype="multipart/form-data">
            <h1>Add the group photo</h1>
            <p>It stays on this machine. No AI assistant receives it.</p>
            <input type="hidden" name="_token" value="{{ csrf_token('photo') }}">
            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required>
            <button>Upload</button>
        </form>
    {% endif %}
</main>
{% endblock %}
